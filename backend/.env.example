# Database
DATABASE_URL=postgresql+asyncpg://techgid:techgid_secret@localhost:5432/techgid
DATABASE_URL_SYNC=postgresql://techgid:techgid_secret@localhost:5432/techgid

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=ТехГид
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=techgid
S3_REGION=us-east-1

# SMS (SMS.ru)
SMS_API_KEY=YOUR_SMS_API_KEY
SMS_SENDER=TechGid

# Email
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@techgid.ru
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_FROM=noreply@techgid.ru

# Content encryption
CONTENT_ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_HEX_STRING

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5
