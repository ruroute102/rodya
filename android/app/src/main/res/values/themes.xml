<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TechGid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.TechGid.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF1A237E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.TechGid</item>
    </style>
</resources>
